{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "loanflow",
  "projectType": "application",
  "sourceRoot": "apps/loanflow/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite --config apps/loanflow/vite.config.ts"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/loanflow"],
      "options": {
        "command": "vite build --config apps/loanflow/vite.config.ts"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview --config apps/loanflow/vite.config.ts --host 127.0.0.1 --port 4300"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/loanflow/tsconfig.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config apps/loanflow/vite.config.ts"
      }
    }
  },
  "tags": ["type:app", "scope:frontend"]
}
